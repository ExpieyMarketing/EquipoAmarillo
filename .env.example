# Copia este archivo a .env.local y rellena los valores.
# Sin estas variables, el panel funciona igualmente mostrando datos de ejemplo (demo).

# --- Meta Ads (Facebook/Instagram) ---
# Token de acceso de un usuario de sistema o app con permiso ads_read sobre la
# cuenta publicitaria. Genera uno en Business Settings > Usuarios del sistema,
# o en el Explorador de la Graph API: https://developers.facebook.com/tools/explorer/
META_ACCESS_TOKEN=
# ID de la cuenta publicitaria, con o sin el prefijo "act_" (ambos funcionan)
META_AD_ACCOUNT_ID=
# Opcional, por defecto v21.0
META_API_VERSION=

# --- Google Ads ---
# Developer token de tu Google Ads Manager Account (Herramientas > Centro de la API)
GOOGLE_ADS_DEVELOPER_TOKEN=
# Credenciales OAuth de un cliente "Aplicación de escritorio" en Google Cloud Console
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Refresh token obtenido una vez mediante el flujo OAuth (ver README)
GOOGLE_ADS_REFRESH_TOKEN=
# ID de la cuenta (cliente) que quieres consultar, sin guiones
GOOGLE_ADS_CUSTOMER_ID=
# Solo si la cuenta anterior cuelga de una cuenta de administrador (MCC), sin guiones
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Opcional, por defecto v19
GOOGLE_ADS_API_VERSION=

# --- General ---
# Moneda para formatear importes, por defecto EUR
NEXT_PUBLIC_CURRENCY=EUR
